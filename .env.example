# ─── Database ──────────────────────────────────────────────────────────────
# Connection string for the Postgres instance. The default matches the
# docker-compose.dev.yml in this repo.
DATABASE_URL=postgresql://hupsup:hupsup@localhost:5432/hupsup_pos
PG_POOL_MAX=10

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate a 32+ byte secret: `openssl rand -base64 32`
AUTH_SECRET=replace_me_with_a_long_random_string
# Public URL of the app (used by Auth.js to build callback URLs)
AUTH_URL=http://localhost:3000

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=HupSup POS
